# Kopiér til .env og udfyld.
DJANGO_SECRET_KEY=skift-mig-til-en-lang-tilfaeldig-streng
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,likviditet.firma.dk
# Kun nødvendig når appen tilgås via https på et domæne:
DJANGO_CSRF_TRUSTED_ORIGINS=https://likviditet.firma.dk
# Sæt til false hvis appen kun kører over http på et internt netværk.
DJANGO_SECURE_COOKIES=true

# e-conomic (kun læseadgang). App-secret er fra jeres e-conomic-app,
# grant-token er pr. aftale (selskab).
ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_GRANT_TOKEN_MEDIATING=
ECONOMIC_GRANT_TOKEN_WEBBLER=
